# ==============================================================================
# OpenSource Clipping — Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in your API keys:
#   cp .env.sample .env
# ==============================================================================

# [REQUIRED] Google Gemini API Key
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# [OPTIONAL] Pexels API Key — needed for B-roll stock footage
# Get yours at: https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key-here

# [OPTIONAL] HuggingFace Token — needed for split-screen mode (Pyannote speaker diarization)
# Get yours at: https://huggingface.co/settings/tokens
# You must also accept the model agreement: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your-hf-token-here


# [REQUIRED IF USING NVIDIA Provider]
# Get yours at: https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key-here

# [OPTIONAL] If using auto uploader for facebook
META_PAGE_ID=111111111111111
META_PAGE_ACCESS_TOKEN=your-meta-api-key-here
META_GRAPH_VERSION=v25.0
APP_TIMEZONE=Asia/Jakarta
# ==============================================================================
# yt-dlp DOWNLOAD / AUTH OPTIONS
# ==============================================================================
# YouTube blocks anonymous downloads from many datacenter / VPS / CI IPs with
# "Sign in to confirm you're not a bot" or HTTP 429. It is also required for
# age-restricted videos. Point this at a Netscape-format cookies.txt exported
# from a browser signed in to YouTube (extension: "Get cookies.txt LOCALLY").
YTDLP_COOKIES=/path/to/cookies.txt

# Alternative to the above: read cookies straight from a local browser profile.
# Only works where the browser is installed (i.e. not in most containers).
# Examples: chrome | firefox | firefox:default | brave
YTDLP_COOKIES_FROM_BROWSER=

# Override the yt-dlp YouTube player_client list (default: tv,web_safari).
YTDLP_PLAYER_CLIENT=

# bgutil PO-token provider base URL. YouTube increasingly serves only
# storyboard images without a PO token. See:
# https://github.com/Brainicism/bgutil-ytdlp-pot-provider
YTDLP_POT_BASE_URL=

# JS runtime used by yt-dlp for signature deciphering (e.g. deno).
YTDLP_JS_RUNTIMES=
